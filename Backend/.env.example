# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# Node Environment ('production' on Render)
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/smartbank?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend URLs for CORS (comma-separated, e.g. https://your-smartbank.vercel.app)
CORS_DOMAINS=https://your-smartbank.vercel.app
